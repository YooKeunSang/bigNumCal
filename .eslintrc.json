{
  "env": {
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "plugins": ["bignumcal"],
  "rules": {
    "bignumcal/no-eval-usage": "error",
    "bignumcal/no-dom-in-core": "error",
    "bignumcal/no-ui-import-in-core": "error",
    "no-eval": "error"
  }
}
